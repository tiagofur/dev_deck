# HeapDeck backend — copy to .env and fill in. Never commit real secrets.
# See docs/PRO_BILLING.md for the Stripe setup walkthrough.

# ─── Core ───
PORT=8080
DB_URL=postgres://heapdeck:heapdeck@localhost:5432/heapdeck?sslmode=disable
# DB_READ_ONLY_URL=postgres://heapdeck:heapdeck@localhost:5432/heapdeck?sslmode=disable
# REDIS_URL=redis://localhost:6379/0
# APP_REGION=us-east
# LOG_LEVEL=info

# ─── Auth ───
# token = single static token (local/dev); jwt = multi-user with OAuth/local.
AUTH_MODE=token
API_TOKEN=change-me-in-production
# JWT_SECRET=64-hex-chars-min-when-jwt-mode
# LOCAL_AUTH_ENABLED=false
# REQUIRE_INVITE=false
# RESEND_API_KEY=
# FRONTEND_URL=http://localhost:5173
# GitHub OAuth (jwt mode)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Google OAuth (jwt mode)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
CORS_ORIGINS=app://.,http://localhost:5173

# ─── AI ───
# heuristic (free, $0) | openai | deepseek | qwen | gemini | ollama | lmstudio | disabled
AI_PROVIDER=heuristic
# AI_EXTERNAL_OPT_IN=true   # required for openai/qwen/deepseek/gemini
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini   # embeddings pair: text-embedding-3-small
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# QWEN_API_KEY=
# QWEN_MODEL=qwen-turbo
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
# LM_STUDIO_BASE_URL=http://localhost:1234
# LM_STUDIO_MODEL=

# ─── Pro billing (hosted cloud only; self-host leaves this off) ───
BILLING_ENABLED=false
# AI_MONTHLY_BUDGET_CENTS=300   # ~$3 priced AI per Pro user per month
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# BILLING_SUCCESS_URL=http://localhost:5173/billing/success
# BILLING_CANCEL_URL=http://localhost:5173/billing/cancel

# ─── GitHub enrichment (optional, raises API rate limits) ───
# GITHUB_TOKEN=ghp_...
