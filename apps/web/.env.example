# DevDeck Web — environment configuration
# Copy to apps/web/.env.local and adjust. All vars are optional in local dev:
# `pnpm dev:web` proxies /api to http://localhost:8080 (see vite.config.ts).

# Base URL of the DevDeck backend API.
# Leave empty in local dev to use the Vite dev-server proxy.
# In production set it to your deployed API origin, e.g. https://devdeck.ai
VITE_API_URL=

# Auth mode: "jwt" (multi-user, default) or "token" (single static API token).
VITE_AUTH_MODE=jwt

# Only used when VITE_AUTH_MODE=token. Must match the backend API_TOKEN.
# Leave empty for jwt mode.
VITE_API_TOKEN=
