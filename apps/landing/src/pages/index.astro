---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="DevDeck.ai — Your AI-assisted external memory for development work" 
  description="Stop losing track of the tools you discover. DevDeck captures repos, CLIs, snippets, and shortcuts—organizing them automatically with AI."
>
  <!-- Navigation Header -->
  <header class="border-b-3 border-ink bg-bg-card sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="bg-accent-yellow border-2 border-ink p-1.5 shadow-hard-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-ink"><path d="M4 3h16a2 2 0 0 1 2 2v6a10 10 0 0 1-10 10A10 10 0 0 1 2 11V5a2 2 0 0 1 2-2z"/><polyline points="8 10 12 14 16 10"/></svg>
        </div>
        <span class="font-display font-black text-2xl uppercase tracking-wider text-ink">
          DevDeck<span class="text-accent-pink">.ai</span>
        </span>
      </div>
      
      <nav class="hidden md:flex items-center gap-8 font-mono text-sm font-bold">
        <a href="https://github.com/tiagofur/dev_deck" target="_blank" rel="noopener" class="hover:text-accent-pink transition-colors">GitHub</a>
        <a href="https://github.com/tiagofur/dev_deck#readme" target="_blank" rel="noopener" class="hover:text-accent-pink transition-colors">Docs</a>
        <a href="https://github.com/tiagofur/dev_deck/releases" target="_blank" rel="noopener" class="hover:text-accent-pink transition-colors">Changelog</a>
        <a href="/es" class="border-2 border-ink px-2.5 py-0.5 bg-bg-primary hover:bg-accent-yellow shadow-hard-sm transition-all flex items-center gap-1">
          ES <span>🇪🇸</span>
        </a>
      </nav>
      
      <div class="flex items-center gap-2">
        <a 
          href="https://github.com/tiagofur/dev_deck" 
          target="_blank" 
          rel="noopener"
          class="border-3 border-ink bg-accent-lime px-4 py-2 font-display font-black uppercase text-sm shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-hard-lg transition-all"
        >
          Star on GitHub
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-7 space-y-6">
      <div class="inline-block border-2 border-ink bg-accent-lavender text-xs font-mono font-black uppercase px-3 py-1.5 shadow-hard-sm">
        🚀 Open Source & Self-Hostable
      </div>
      
      <h1 class="font-display font-black text-4xl sm:text-6xl uppercase tracking-tight leading-none text-ink">
        Your AI-assisted <span class="bg-accent-yellow border-b-5 border-ink px-1">external memory</span> for dev work.
      </h1>
      
      <p class="font-mono text-base sm:text-lg text-ink-soft leading-relaxed max-w-xl">
        Stop losing track of the tools you discover. DevDeck captures repos, CLIs, snippets, and shortcuts—organizing them automatically with AI.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 pt-4">
        <a 
          href="https://github.com/tiagofur/dev_deck/releases" 
          target="_blank"
          rel="noopener"
          class="border-3 border-ink bg-accent-pink text-center px-6 py-4 font-display font-black uppercase text-lg shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-hard-lg transition-all flex items-center justify-center gap-2"
        >
          Get DevDeck for Desktop
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a 
          href="https://app.devdeck.ai" 
          target="_blank"
          rel="noopener"
          class="border-3 border-ink bg-bg-card text-center px-6 py-4 font-display font-black uppercase text-lg shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-hard-lg transition-all flex items-center justify-center gap-2"
        >
          Try Web Version
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
        </a>
      </div>
      
      <div class="pt-6 flex flex-wrap gap-4 text-xs font-mono text-ink-soft">
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-yellow"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Offline-First
        </span>
        <span class="text-ink/30">•</span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-pink"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Privacy-First
        </span>
        <span class="text-ink/30">•</span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-danger"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          100% Free
        </span>
      </div>
    </div>
    
    <div class="lg:col-span-5 relative">
      <div class="bg-bg-card border-5 border-ink p-4 shadow-hard-xl rotate-1 hover:rotate-0 transition-transform duration-300">
        <div class="border-3 border-ink bg-bg-elevated p-4 font-mono text-xs space-y-4">
          <div class="flex items-center justify-between border-b-2 border-ink border-dashed pb-2">
            <span class="font-bold uppercase text-[10px] bg-accent-yellow px-1.5 border border-ink text-ink">devdeck-brain-v1</span>
            <span class="text-ink-soft">Capture: OK</span>
          </div>
          
          <div class="bg-bg-primary border-2 border-ink p-3 space-y-2">
            <div class="font-bold text-accent-pink">type: repo</div>
            <div class="font-bold uppercase text-sm">chubin/cheat.sh</div>
            <p class="text-[11px] text-ink-soft leading-normal">
              Unified access to the best community driven cheat sheets repositories of the world.
            </p>
          </div>
          
          <div class="bg-bg-primary border-2 border-ink p-3 space-y-2">
            <div class="font-bold text-accent-lime">type: cli</div>
            <div class="font-bold uppercase text-sm">fzf</div>
            <p class="text-[11px] text-ink-soft leading-normal">
              A general-purpose command-line fuzzy finder. Extremely fast.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Strip -->
  <section class="border-y-3 border-ink bg-bg-card">
    <div class="max-w-6xl mx-auto px-6 py-8 grid grid-cols-1 md:grid-cols-3 gap-8 text-center font-mono">
      <div class="space-y-1">
        <div class="font-display font-black text-4xl text-accent-pink uppercase">10+</div>
        <div class="text-xs uppercase font-bold text-ink-soft">Supported Item Types</div>
      </div>
      <div class="space-y-1 border-y-2 md:border-y-0 md:border-x-2 border-ink border-dashed py-4 md:py-0">
        <div class="font-display font-black text-4xl text-accent-yellow uppercase">&lt; 100ms</div>
        <div class="text-xs uppercase font-bold text-ink-soft">Search Latency</div>
      </div>
      <div class="space-y-1">
        <div class="font-display font-black text-4xl text-accent-lime uppercase">100%</div>
        <div class="text-xs uppercase font-bold text-ink-soft">Open Source</div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="max-w-6xl mx-auto px-6 py-20 space-y-12">
    <div class="text-center space-y-4 max-w-2xl mx-auto">
      <h2 class="font-display font-black text-4xl sm:text-5xl uppercase tracking-tight text-ink">
        Built for developers who save tools.
      </h2>
      <p class="font-mono text-sm text-ink-soft">
        DevDeck acts as your secondary memory, cataloging and explaining everything you bookmark.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Capture -->
      <div class="bg-bg-card border-3 border-ink p-6 shadow-hard space-y-4 hover:-translate-y-1 hover:shadow-hard-lg transition-all">
        <div class="w-12 h-12 border-2 border-ink bg-accent-yellow flex items-center justify-center shadow-hard-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-ink"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
        </div>
        <h3 class="font-display font-black text-xl uppercase tracking-wider text-ink">
          Capture from anywhere
        </h3>
        <p class="font-mono text-xs text-ink-soft leading-relaxed">
          Whether you're in the browser, the terminal, or just copied a URL, DevDeck is ready to save it. No friction, no manual tagging.
        </p>
      </div>

      <!-- Search -->
      <div class="bg-bg-card border-3 border-ink p-6 shadow-hard space-y-4 hover:-translate-y-1 hover:shadow-hard-lg transition-all">
        <div class="w-12 h-12 border-2 border-ink bg-accent-pink flex items-center justify-center shadow-hard-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-ink"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <h3 class="font-display font-black text-xl uppercase tracking-wider text-ink">
          Find by intent
        </h3>
        <p class="font-mono text-xs text-ink-soft leading-relaxed">
          Can't remember the name? Just search for what it does. <span class="bg-accent-yellow/20 px-1 border border-ink/10 italic">"That Go CLI for image optimization"</span>—the AI knows exactly what you mean.
        </p>
      </div>

      <!-- Privacy -->
      <div class="bg-bg-card border-3 border-ink p-6 shadow-hard space-y-4 hover:-translate-y-1 hover:shadow-hard-lg transition-all">
        <div class="w-12 h-12 border-2 border-ink bg-accent-lime flex items-center justify-center shadow-hard-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-ink"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h3 class="font-display font-black text-xl uppercase tracking-wider text-ink">
          Offline-First & OS
        </h3>
        <p class="font-mono text-xs text-ink-soft leading-relaxed">
          Your data belongs to you. Run DevDeck locally on your machine or host it yourself. It works without internet and respects your privacy.
        </p>
      </div>
    </div>
  </section>

  <!-- Support Section -->
  <section class="bg-bg-elevated border-t-3 border-ink">
    <div class="max-w-4xl mx-auto px-6 py-16 text-center space-y-6">
      <h2 class="font-display font-black text-3xl sm:text-4xl uppercase tracking-tight text-ink">
        Support the project
      </h2>
      <p class="font-mono text-sm text-ink-soft max-w-md mx-auto">
        Love DevDeck? Help us keep the coffee flowing and the code shipping.
      </p>
      <div>
        <a 
          href="https://www.buymeacoffee.com/tiagofur" 
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 border-3 border-ink bg-accent-orange px-6 py-3 font-display font-black uppercase text-md shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-hard-lg transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-ink"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          Buy us a coffee
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t-3 border-ink bg-bg-card py-12">
    <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6 font-mono text-xs text-ink-soft">
      <div class="flex items-center gap-2">
        <span class="font-display font-black uppercase text-sm tracking-wider text-ink">
          DevDeck<span class="text-accent-pink">.ai</span>
        </span>
        <span>© {new Date().getFullYear()}</span>
      </div>
      
      <div class="flex gap-6">
        <a href="https://github.com/tiagofur/dev_deck" target="_blank" rel="noopener" class="hover:text-accent-pink transition-colors">GitHub</a>
        <a href="https://github.com/tiagofur/dev_deck#readme" target="_blank" rel="noopener" class="hover:text-accent-pink transition-colors">Docs</a>
        <a href="https://github.com/tiagofur/dev_deck/releases" target="_blank" rel="noopener" class="hover:text-accent-pink transition-colors">Changelog</a>
      </div>
      
      <div>
        <a href="/es" class="hover:text-accent-pink transition-colors flex items-center gap-1">
          🇪🇸 Leer en español
        </a>
      </div>
    </div>
  </footer>
</Layout>
