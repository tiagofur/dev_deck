{
  "name": "devdeck",
  "version": "0.6.0",
  "description": "DevDeck monorepo — desktop, web, shared packages.",
  "scripts": {
    "dev:desktop": "pnpm -F @devdeck/desktop dev",
    "dev:web": "pnpm -F @devdeck/web dev",
    "dev:landing": "pnpm -F @devdeck/landing dev",
    "build:desktop": "pnpm -F @devdeck/desktop build",
    "build:web": "pnpm -F @devdeck/web build",
    "build:landing": "pnpm -F @devdeck/landing build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:commit": "commitlint --edit",
    "release": "bumpp --files CHANGELOG.md package.json",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:all": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "bumpp": "^9.4.0",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "husky": "^9.1.0",
    "prettier": "^3.8.4",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.61.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
