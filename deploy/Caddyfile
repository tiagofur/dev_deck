# Caddyfile — DevDeck reverse proxy with automatic HTTPS

# Main Domain (Web App)
{$DOMAIN} {
    encode gzip zstd

    # Health check is public
    handle /healthz {
        reverse_proxy api:8080
    }

    # API proxy
    handle /api/* {
        reverse_proxy api:8080
    }

    # SPA — serve React app
    handle /* {
        reverse_proxy web:3000
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# Monitoring Domain (Grafana)
monitor.{$DOMAIN} {
    reverse_proxy grafana:3000
    
    # Basic auth recommended for monitoring if not using Grafana internal auth
    # For now, we rely on Grafana's login screen.
}
