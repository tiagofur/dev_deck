# DevDeck Environment Configuration (v1.0)
# Copy to deploy/.env and adjust for production

DOMAIN=devdeck.ai
FRONTEND_URL=https://devdeck.ai

# Postgres
PG_PASS=devdeck_pass

# Auth Mode (v1.0 uses jwt for multi-user/multi-device)
AUTH_MODE=jwt
LOCAL_AUTH_ENABLED=true
ALLOWED_GITHUB_LOGINS=tu-usuario-github

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://devdeck.ai/api/auth/github/callback
WEB_OAUTH_REDIRECT_URL=https://devdeck.ai/auth/callback
DESKTOP_OAUTH_REDIRECT_URL=devdeck://auth/callback

# JWT Secrets (Generate with: openssl rand -hex 32)
JWT_SECRET=
REFRESH_SECRET=

# AI (openai | ollama | heuristic)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_EXTERNAL_OPT_IN=true

# Logging & Monitoring
LOG_LEVEL=info
CORS_ORIGINS=https://devdeck.ai,app://.
SEED_CHEATSHEETS=true
