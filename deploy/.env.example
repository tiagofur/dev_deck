# HeapDeck Environment Configuration (v1.0)
# Copy to deploy/.env and adjust for production

DOMAIN=heapdeck.com
FRONTEND_URL=https://heapdeck.com

# Postgres
PG_PASS=heapdeck_pass

# Auth Mode (v1.0 uses jwt for multi-user/multi-device)
AUTH_MODE=jwt
# ADR 0004: refresh token in an HttpOnly cookie for web (desktop keeps the deep-link pair)
AUTH_COOKIE_MODE=true
LOCAL_AUTH_ENABLED=true

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://api.heapdeck.com/api/auth/github/callback

# Google OAuth (optional: set both credentials to show the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://api.heapdeck.com/api/auth/google/callback
WEB_OAUTH_REDIRECT_URL=https://heapdeck.com/auth/callback
DESKTOP_OAUTH_REDIRECT_URL=heapdeck://auth/callback

# JWT Secrets (Generate with: openssl rand -hex 32)
JWT_SECRET=
REFRESH_SECRET=

# AI (openai | ollama | heuristic)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_EXTERNAL_OPT_IN=true

# Logging & Monitoring
LOG_LEVEL=info
CORS_ORIGINS=https://heapdeck.com,app://.
SEED_CHEATSHEETS=true
